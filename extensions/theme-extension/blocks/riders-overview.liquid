{% comment %}
    This block registers the custom code required to show the riders overview on any page.

    It loads the riders automatically and shows them in a 2 column grid.
{% endcomment %}
{% liquid
    assign settings = block.settings

    assign block_id = block.id
    assign wrapper_id = 'riders-overview-' | append: block_id

    assign riders = shop.metaobjects.rider.values
%}

{% comment %} Block specific logic {% endcomment %}
{% liquid
    assign wrapper_id_css = "#" |  append: wrapper_id
    assign riders_count = 0

    for rider in riders
        increment rider_count
    endfor

    assign mobile_riders_per_column = 1
    assign desktop_riders_per_column = 2
    assign grid_rows_desktop = riders_count | divided_by: desktop_riders_per_column | ceil
    assign grid_row_end_desktop = grid_rows_desktop | plus: 0
    assign grid_rows_mobile = riders_count | divided_by: mobile_riders_per_column | ceil
    assign grid_row_start_mobile = grid_rows_mobile | plus: 1
%}
{% comment %} Styling {% endcomment %}
<style>
.rider-overview--list {
    --grid-row-start-mobile: {{  grid_row_start_mobile }};
    --grid-row-end-desktop: {{ grid_row_end_desktop }};
}
</style>

{% comment %} Block markup {% endcomment %}
<div class="riders-overview has-showreel" id="{{ wrapper_id }}">
    {% for rider in riders %}
        {% render 'rider.showreel' with rider as rider %}
    {% endfor %}

    <ul class="rider-overview--list">
       {% for rider in riders %}
            <li>{% render 'rider.li' with rider as rider %}</li>
        {% endfor %}
    </ul>
</div>

{% schema %}
{
  "name": "t:Blocks.RiderOverview.Name",
  "target": "section",
  "javascript": "rider-showreel.js",
  "stylesheet": "rider-showreel.css",
  "settings": []
}
{% endschema %}
